{
  "name": "mauri-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3007",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3007",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json docs README.md AGENTS.md",
    "format:check": "prettier --check src tests *.ts *.mjs *.json docs README.md AGENTS.md"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
